# ─── アプリ ─────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── データベース（Neon / PostgreSQL）───────────
# アプリからの接続は pooled（-pooler 付き）を使う
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# マイグレーション用。pooler を経由しない直接接続
DIRECT_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── 認証（Auth.js）── Phase 1 ──────────────────
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Stripe（テストキー）── Phase 4 ─────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# `npm run stripe:listen` の出力に表示される値。本番の値とは別物
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── メール（Resend）── Phase 1 ─────────────────
RESEND_API_KEY=""
MAIL_FROM="FUNDBEAT <onboarding@resend.dev>"

# ─── 画像ストレージ（Cloudflare R2）── Phase 2 ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="fundbeat-uploads"
R2_PUBLIC_URL=""

# ─── Cron の保護 ── Phase 5 ─────────────────────
# openssl rand -hex 32
CRON_SECRET=""
