// FUNDBEAT（仮）— DB スキーマ
//
// 設計の根拠は docs/03-db-schema.md と docs/11-payment-hardening.md を参照。
// 応援ポイント関連のモデル（PointAccount / PointTransaction / ReferralClick）は
// Phase 9 で追加する。初期マイグレーションには含めない。
//
// 原則:
//   - 金額はすべて Int（円）。小数は使わない
//   - 削除は原則論理削除（deletedAt）。会計記録が絡むため物理削除しない
//   - 集計値は非正規化キャッシュ。更新は必ずトランザクション内
//   - 日時はすべて UTC 保存。表示時に JST 変換

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════════
//  Enums
// ══════════════════════════════════════════════════

enum UserRole {
  BACKER
  CREATOR
  ADMIN
}

enum FundingType {
  ALL_IN
  ALL_OR_NOTHING
}

enum ProjectStatus {
  DRAFT
  IN_REVIEW
  REJECTED
  SCHEDULED
  LIVE
  SUCCEEDED
  FAILED
  FULFILLING
  COMPLETED
  SUSPENDED
}

enum PledgeStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  PAYMENT_FAILED
  CANCELED
  REFUNDED
  EXPIRED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
}

enum CreatorOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  RESTRICTED
  COMPLETE
}

/// 特商法表記における住所・電話番号の開示方法
/// 弁護士確認事項（decisions.md G-5）。出品者の獲得しやすさに直結する
enum CreatorDisclosureMode {
  PUBLIC
  ON_REQUEST
}

enum JournalType {
  PLEDGE_CAPTURE
  PSP_FEE_SETTLE
  FEE_ADJUSTMENT
  TRANSFER_TO_CREATOR
  REFUND
  DISPUTE_OPEN
  DISPUTE_WON
  DISPUTE_LOST
  MANUAL_ADJUSTMENT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ══════════════════════════════════════════════════
//  Auth.js 標準モデル
// ══════════════════════════════════════════════════

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ══════════════════════════════════════════════════
//  ユーザー
// ══════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  handle        String?   @unique
  image         String?
  bio           String?   @db.Text
  websiteUrl    String?
  twitterHandle String?
  role          UserRole  @default(BACKER)

  /// 支援者としての Stripe Customer。カード保存に使う
  stripeCustomerId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts       Account[]
  sessions       Session[]
  creatorProfile CreatorProfile?
  pledges        Pledge[]
  comments       Comment[]
  reports        Report[]        @relation("Reporter")

  @@index([role])
}

/// 出品者としての情報。CREATOR に昇格したユーザーだけが持つ
model CreatorProfile {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  isBusiness  Boolean @default(false)

  // ── 特商法表記用（legal/tokushoho.md §3）──────────
  legalName      String?
  postalCode     String?
  address        String?
  phoneNumber    String?
  disclosureMode CreatorDisclosureMode @default(ON_REQUEST)

  // ── Stripe Connect ────────────────────────────
  stripeAccountId  String?                 @unique
  onboardingStatus CreatorOnboardingStatus @default(NOT_STARTED)
  chargesEnabled   Boolean                 @default(false)
  payoutsEnabled   Boolean                 @default(false)

  // ── 出品者申請 ────────────────────────────────
  appliedAt    DateTime?
  approvedAt   DateTime?
  approvedBy   String?
  rejectedAt   DateTime?
  rejectReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@index([onboardingStatus])
}

// ══════════════════════════════════════════════════
//  プロジェクト
// ══════════════════════════════════════════════════

model Category {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  emoji     String?
  sortOrder Int    @default(0)

  projects Project[]
}

model Project {
  id         String  @id @default(cuid())
  slug       String  @unique
  creatorId  String
  categoryId String?

  creator  CreatorProfile @relation(fields: [creatorId], references: [id])
  category Category?      @relation(fields: [categoryId], references: [id])

  title         String
  tagline       String  @db.VarChar(120)
  description   String  @db.Text
  coverImageUrl String?
  videoUrl      String?

  /// 公開後は変更不可（server/actions で必ずガードする）
  fundingType FundingType @default(ALL_IN)
  goalAmount  Int
  startAt     DateTime
  endAt       DateTime

  status      ProjectStatus @default(DRAFT)
  publishedAt DateTime?
  closedAt    DateTime?

  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedBy    String?
  reviewComment String?   @db.Text

  /// 集計キャッシュ。台帳・Pledge から再計算できる（reconcile で毎日突合）
  currentAmount Int @default(0)
  backerCount   Int @default(0)
  viewCount     Int @default(0)

  /// 掲載承認時の料率をスナップショットする。ベーシスポイント（1000 = 10.00%）
  /// 料率を変更しても既存プロジェクトの条件は変わらない（terms.md 第14条3項）
  platformFeeRate Int @default(1000)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rewards  Reward[]
  pledges  Pledge[]
  updates  ProjectUpdate[]
  images   ProjectImage[]
  comments Comment[]
  payouts  Payout[]
  reports  Report[]

  @@index([status, endAt])
  @@index([categoryId, status])
  @@index([creatorId])
  @@index([status, currentAmount])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Reward {
  id        String @id @default(cuid())
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String  @db.Text
  amount      Int
  imageUrl    String?

  /// null = 無制限
  quantityLimit   Int?
  quantityClaimed Int  @default(0)

  estimatedDeliveryAt DateTime?
  shippingRequired    Boolean   @default(false)

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  pledges Pledge[]

  @@index([projectId, sortOrder])
}

model ProjectUpdate {
  id        String @id @default(cuid())
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  body        String  @db.Text
  backersOnly Boolean @default(false)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, publishedAt])
}

model Comment {
  id        String @id @default(cuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  body     String  @db.Text
  isHidden Boolean @default(false)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([projectId, createdAt])
}

// ══════════════════════════════════════════════════
//  支援・決済
// ══════════════════════════════════════════════════

model Pledge {
  id        String  @id @default(cuid())
  projectId String
  backerId  String
  rewardId  String?

  project Project @relation(fields: [projectId], references: [id])
  backer  User    @relation(fields: [backerId], references: [id])
  reward  Reward? @relation(fields: [rewardId], references: [id])

  // ── 金額の内訳（すべて円）────────────────────
  rewardAmount  Int
  additionalTip Int @default(0)
  totalAmount   Int
  platformFee   Int
  stripeFee     Int @default(0)
  creatorPayout Int

  quantity Int @default(1)

  status PledgeStatus @default(PENDING)

  // ── Stripe ────────────────────────────────────
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeSetupIntentId     String? @unique
  stripePaymentMethodId   String?
  stripeChargeId          String?
  stripeRefundId          String?

  /// 適用済み Stripe イベントのうち最新の created。順序逆転の検知に使う
  lastStripeEventAt DateTime?

  // ── 決済リトライ ──────────────────────────────
  paymentAttempts      Int       @default(0)
  lastPaymentError     String?   @db.Text
  lastPaymentAttemptAt DateTime?

  supporterMessage String?  @db.Text
  isAnonymous      Boolean  @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  capturedAt DateTime?
  canceledAt DateTime?
  refundedAt DateTime?
  disputedAt DateTime?

  shippingAddress ShippingAddress?

  @@index([projectId, status])
  @@index([backerId, createdAt])
  @@index([status, createdAt])
}

model ShippingAddress {
  id       String @id @default(cuid())
  pledgeId String @unique

  pledge Pledge @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  recipientName String
  postalCode    String
  prefecture    String
  city          String
  addressLine1  String
  addressLine2  String?
  phoneNumber   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 出品者への入金記録
model Payout {
  id        String @id @default(cuid())
  projectId String

  project Project @relation(fields: [projectId], references: [id])

  grossAmount Int
  platformFee Int
  stripeFee   Int
  netAmount   Int

  status           PayoutStatus @default(PENDING)
  stripeTransferId String?      @unique
  stripePayoutId   String?
  arrivalDate      DateTime?
  failureReason    String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// ══════════════════════════════════════════════════
//  台帳（複式簿記）— docs/11-payment-hardening.md §1
// ══════════════════════════════════════════════════

/// 仕訳ヘッダ。1つの経済事象 = 1レコード
model LedgerJournal {
  id   String      @id @default(cuid())
  type JournalType

  /// 冪等キー。"pledge-capture-<id>" のように事象から一意に決まる文字列
  externalRef String @unique

  pledgeId  String?
  projectId String?
  memo      String? @db.Text

  /// MANUAL_ADJUSTMENT では必須
  operatorId String?

  /// 経済事象が起きた時刻（Stripe 側の時刻）
  occurredAt DateTime
  createdAt  DateTime @default(now())

  entries LedgerEntry[]

  @@index([type, occurredAt])
  @@index([pledgeId])
  @@index([projectId])
}

/// 仕訳明細。append-only。UPDATE / DELETE はトリガーで禁止する
model LedgerEntry {
  id        String @id @default(cuid())
  journalId String

  journal LedgerJournal @relation(fields: [journalId], references: [id])

  account   String
  subjectId String?
  /// 符号付き（円）。プラス = 借方、マイナス = 貸方。1仕訳の合計は必ず 0
  amount    Int
  currency  String  @default("JPY")

  createdAt DateTime @default(now())

  @@index([account, subjectId])
  @@index([journalId])
}

// ══════════════════════════════════════════════════
//  システム
// ══════════════════════════════════════════════════

/// Stripe Webhook の冪等性を保証する
model WebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  payload       Json
  processedAt   DateTime?
  error         String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([type, createdAt])
}

/// 副作用（メール送信など）を DB 更新と同一トランザクションで積む
model OutboxMessage {
  id      String       @id @default(cuid())
  topic   String
  payload Json
  status  OutboxStatus @default(PENDING)

  attempts  Int      @default(0)
  lastError String?  @db.Text
  runAfter  DateTime @default(now())

  /// 同じ通知を二度送らないためのキー
  dedupeKey String? @unique

  createdAt DateTime @default(now())

  @@index([status, runAfter])
}

/// お金と権限に関わる操作の記録
model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actorType  String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  /// 運営操作（返金・手動調整）では必須
  reason     String? @db.Text
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}

/// デプロイせずに機能を止めるためのキルスイッチ
model SystemFlag {
  key       String   @id
  value     Boolean
  reason    String?
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Report {
  id         String  @id @default(cuid())
  projectId  String
  reporterId String?

  project  Project @relation(fields: [projectId], references: [id])
  reporter User?   @relation("Reporter", fields: [reporterId], references: [id])

  reason     String
  detail     String?   @db.Text
  resolvedAt DateTime?
  resolvedBy String?
  resolution String?   @db.Text

  createdAt DateTime @default(now())

  @@index([resolvedAt])
}
